{
  "name": "shoplist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-exclusive.mjs dev",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "prepreview": "node scripts/check-exclusive.mjs preview",
    "server": "node server/index.mjs",
    "preserver": "node scripts/check-exclusive.mjs preview",
    "server:dev": "node --watch server/index.mjs",
    "parse": "node scripts/parsear.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "typecheck:watch": "tsc -b --watch",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.0",
    "prettier": "^3.4.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": "eslint --fix",
    "*.{ts,tsx,js,mjs,cjs,json,css,md}": "prettier --write --ignore-unknown"
  }
}
